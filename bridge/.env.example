# Bridge configuration — copy to .env (never commit .env)
INGEST_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/ingest-punches
DEVICE_INGEST_SECRET=YOUR_LONG_RANDOM_DEVICE_SECRET
DEVICES=[{"name":"Mess 7 Counter 1","serial":"YOUR_DEVICE_SERIAL","ip":"192.168.1.201","port":4370}]
POLL_INTERVAL_SECONDS=30

# --- optional ---
# ADAPTER=mock | pull | adms        (default: pull; `npm run mock` forces mock)
# ADMS_PORT=8081                     (adms adapter: port the machines push to)
# DEVICE_UTC_OFFSET=+05:30           (timezone the machine clock is set to)
# MOCK_INTERVAL_SECONDS=4            (mock adapter: seconds between fake punches)
# MOCK_FIRST_PIN=1001  MOCK_LAST_PIN=1030
# MOCK_MEAL_TIME=12:30               (mock adapter: stamp punches with this IST time today instead of "now";
#                                     handy to demo outside meal hours. Punches >10 min from server time are
#                                     flagged needs_review, by design.)
# DATA_DIR=./data                    (offline queue + last-seen state)
