# Web app — copy to .env.local (never commit it)
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Server-side only, never exposed to the browser. NOTE: the current web app does not need it
# (all privileged work happens in SECURITY DEFINER SQL functions called with the user's own session),
# so you may leave it unset. It is reserved for future server-only jobs.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SHOW_DEMO_HINT=true   # shows demo logins on the sign-in page; remove in production
